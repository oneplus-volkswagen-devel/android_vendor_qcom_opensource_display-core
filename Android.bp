soong_config_module_type {
    name: "qtidisplay_core_defaults",
    module_type: "cc_defaults",
    config_namespace: "qtidisplay",
    bool_variables: ["reserve_30hz_aod"],
    properties: ["cflags"],
}

qtidisplay_core_defaults {
    name: "qtidisplay_reserve_30hz_aod_defaults",
    soong_config_variables: {
        reserve_30hz_aod: {
            cflags: ["-DOPLUS_RESERVE_30HZ_AOD"],
        },
    },
}

cc_library_headers {
    name: "display_debug_headers",
    vendor: true,
    export_include_dirs: [
        "libdebug",
    ],
}

cc_library_headers {
  name: "display_core_headers",
  vendor: true,
  export_include_dirs: [
    "include",
    "libdrmutils",
    "sdm/include",
  ],
  header_libs: [
      "libhardware_headers",
      "display_intf_headers",
      "display_debug_headers",
      "common_interface_headers",
      "snapalloc_interface_headers",
  ],
  export_header_lib_headers: [
      "libhardware_headers",
      "display_intf_headers",
      "display_debug_headers",
      "common_interface_headers",
      "snapalloc_interface_headers",
  ],
}
